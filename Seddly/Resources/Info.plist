<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- US-170: Xcode's "Process Info.plist" step injects CFBundleIdentifier,
         CFBundleExecutable, and CFBundleName automatically, but NOT the two
         version keys — those only appear when GENERATE_INFOPLIST_FILE is on,
         which it is not when INFOPLIST_FILE names a hand-authored plist. Without
         them, MARKETING_VERSION / CURRENT_PROJECT_VERSION from project.yml never
         reach any bundle, the release workflow's build-number override is a
         no-op, and App Store validation rejects the archive. All four targets
         resolve the same two variables so their versions always match, which
         App Store Connect requires of app extensions. -->
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Seddly reads only your Screenshots album to find commitments, promises, and deadlines. Your personal photos and videos are never accessed.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>Seddly needs permission to save exported commitment timelines to your photo library.</string>
    <key>NSCalendarsUsageDescription</key>
    <string>Seddly creates calendar events for your commitment deadlines so you never miss a due date.</string>
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>Seddly needs full calendar access to create and manage events for your commitment deadlines.</string>
    <key>NSFaceIDUsageDescription</key>
    <string>Seddly uses Face ID to keep your commitments and entity profiles private when the app is reopened.</string>
    <!-- US-169: The seddly:// scheme backs the deep links handled in
         SeddlyApp.onOpenURL. It previously lived in project.yml under an
         `info:` block that XcodeGen never applied (a Plist entry requires a
         `path:`), so the scheme never reached the built bundle and every
         seddly:// link failed to open the app. Declared here instead, in the
         Info.plist the target actually processes. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.pearsonmedia.Seddly</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>seddly</string>
            </array>
        </dict>
    </array>
    <!-- US-151: Live Activities for the next-due commitment -->
    <key>NSSupportsLiveActivities</key>
    <true/>
    <key>NSSupportsLiveActivitiesFrequentUpdates</key>
    <false/>
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
        <string>com.pearsonmedia.Seddly.screenshot-refresh</string>
    </array>
    <key>UIBackgroundModes</key>
    <array>
        <string>fetch</string>
        <string>remote-notification</string>
    </array>
    <!-- US-160: Branded launch screen. Avoids the blank-white flash before the
         first SwiftUI frame renders. The background matches the midpoint of
         the OnboardingView hero gradient. -->
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>LaunchBackground</string>
    </dict>
    <!-- Populated from Seddly/Config/*.xcconfig. See AppConfiguration.swift for
         the placeholder / empty-string fallback behavior. -->
    <key>SUPABASE_URL</key>
    <string>$(SUPABASE_URL)</string>
    <key>SUPABASE_KEY</key>
    <string>$(SUPABASE_ANON_KEY)</string>
    <key>AI_EXTRACTION_ENDPOINT</key>
    <string>$(AI_EXTRACTION_ENDPOINT)</string>
    <!-- US-147: App Transport Security. Default-deny with an explicit TLS 1.3
         exception for Supabase. CertificatePinningService layers on top of this
         floor to enforce our SPKI pins. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
        <key>NSAllowsLocalNetworking</key>
        <false/>
        <key>NSExceptionDomains</key>
        <dict>
            <key>supabase.co</key>
            <dict>
                <key>NSIncludesSubdomains</key>
                <true/>
                <key>NSExceptionMinimumTLSVersion</key>
                <string>TLSv1.3</string>
                <key>NSExceptionRequiresForwardSecrecy</key>
                <true/>
                <key>NSExceptionAllowsInsecureHTTPLoads</key>
                <false/>
            </dict>
        </dict>
    </dict>
</dict>
</plist>
