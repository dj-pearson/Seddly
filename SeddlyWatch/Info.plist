<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- US-170: must match the companion iOS app exactly — App Store Connect
         rejects a submission whose watch app version differs from the app's. -->
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <!-- US-171: required for a single-target watchOS app. Without it the bundle
         is treated as a legacy WatchKit app with a missing extension and fails
         to launch or validate. -->
    <key>WKApplication</key>
    <true/>
    <key>WKCompanionAppBundleIdentifier</key>
    <string>com.pearsonmedia.Seddly</string>
    <!-- US-171: WatchLedgerView.onOpenURL already parses seddly-watch:// links,
         and the complication's widgetURL emits them, but the scheme was never
         registered — so tapping a complication opened the app to the default
         view instead of the requested filter. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.pearsonmedia.Seddly.watchkitapp</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>seddly-watch</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
