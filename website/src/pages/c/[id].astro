---
import BaseLayout from '../../layouts/BaseLayout.astro';

const { id } = Astro.params;
---

<BaseLayout title="Seddly — Commitment Shared" description="View this commitment in the Seddly app.">
  <section class="share-page">
    <div class="share-inner">
      <div class="app-icon">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 11l3 3L22 4"/>
          <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
        </svg>
      </div>
      <h1>Open in Seddly</h1>
      <p class="share-sub">Someone shared a commitment record with you.</p>
      <p class="share-id">Reference: <code>{id}</code></p>

      <a href={`seddly://c/${id}`} class="cta">Open in App</a>

      <div class="fallback">
        <p>Don't have Seddly?</p>
        <a href="https://apps.apple.com/app/seddly/id0000000000" class="cta-secondary">Download for iOS</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .share-page {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }
  .share-inner {
    text-align: center;
    max-width: 480px;
  }
  .app-icon {
    color: var(--color-accent);
    margin-bottom: 1.5rem;
  }
  h1 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }
  .share-sub {
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }
  .share-id {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    margin-bottom: 2rem;
  }
  .share-id code {
    background: var(--color-surface);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-family: monospace;
  }
  .cta {
    display: inline-block;
    background: var(--color-accent);
    color: white;
    padding: 0.8rem 2rem;
    border-radius: 10px;
    font-weight: 600;
    font-size: 1rem;
    margin-bottom: 2rem;
  }
  .cta:hover {
    background: var(--color-accent-hover);
    color: white;
  }
  .fallback {
    border-top: 1px solid var(--color-border);
    padding-top: 1.5rem;
  }
  .fallback p {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-bottom: 0.8rem;
  }
  .cta-secondary {
    display: inline-block;
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
    padding: 0.6rem 1.5rem;
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .cta-secondary:hover {
    background: var(--color-accent);
    color: white;
  }
</style>
