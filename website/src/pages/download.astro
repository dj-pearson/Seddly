---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Download Seddly — Free Promise Tracker for iOS"
  description="Download Seddly for iPhone. Turn screenshots into tracked commitments with on-device AI. Free tier available, no account required."
  keywords="download seddly, seddly app, promise tracker download, screenshot tracker iOS, accountability app download"
>
  <section class="download-hero">
    <div class="download-inner">
      <h1>Download Seddly</h1>
      <p class="subtitle">Turn screenshots into accountability. Available for iOS.</p>

      <div class="store-buttons" id="store-buttons">
        <a href="#" id="ios-btn" class="store-btn ios-btn" aria-label="Download on the App Store">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
          <div>
            <span class="store-label">Download on the</span>
            <span class="store-name">App Store</span>
          </div>
        </a>
      </div>

      <p class="coming-soon-note" id="android-note" style="display:none;">
        Android version coming soon. <a href="/support">Get notified</a> when it launches.
      </p>

      <div class="plan-summary">
        <div class="plan">
          <h3>Free</h3>
          <p>5 commitments, on-device processing, basic alerts</p>
        </div>
        <div class="plan featured">
          <h3>Pro — $4.99/mo</h3>
          <p>Unlimited commitments, AI extraction, full notifications, entity profiles</p>
        </div>
        <div class="plan">
          <h3>Pro+ — $9.99/mo</h3>
          <p>Everything in Pro + AI dispute summaries, PDF export, iCloud sync</p>
        </div>
      </div>
    </div>
  </section>

  <section class="requirements">
    <div class="download-inner">
      <h2>Requirements</h2>
      <ul>
        <li>iPhone running iOS 17 or later</li>
        <li>No account required for Free and Pro tiers</li>
        <li>Screenshots album access (photos and personal images are never accessed)</li>
      </ul>
    </div>
  </section>

  <script>
    // Platform detection for app store routing
    (function() {
      const ua = navigator.userAgent || '';
      const isAndroid = /android/i.test(ua);
      const androidNote = document.getElementById('android-note');

      if (isAndroid && androidNote) {
        androidNote.style.display = 'block';
      }

      // When iOS App Store link is live, replace '#' with the actual App Store URL:
      // const iosBtn = document.getElementById('ios-btn');
      // if (iosBtn) iosBtn.href = 'https://apps.apple.com/app/seddly/idAPPSTORE_ID';

      // Auto-redirect mobile visitors to app store (uncomment when app is live):
      // const isIOS = /iPad|iPhone|iPod/.test(ua);
      // if (isIOS) window.location.href = 'https://apps.apple.com/app/seddly/idAPPSTORE_ID';
    })();
  </script>
</BaseLayout>

<style>
  .download-hero {
    text-align: center;
    padding: 6rem 2rem 4rem;
  }

  .download-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 2rem;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.75rem;
  }

  .subtitle {
    font-size: 1.2rem;
    color: var(--color-text-muted);
    margin-bottom: 2.5rem;
  }

  .store-buttons {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .store-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: white;
    color: #000;
    padding: 0.75rem 1.75rem;
    border-radius: 12px;
    font-weight: 600;
    transition: transform 0.2s, box-shadow 0.2s;
    text-align: left;
  }

  .store-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(91, 127, 245, 0.2);
    color: #000;
  }

  .store-label {
    display: block;
    font-size: 0.7rem;
    font-weight: 400;
    line-height: 1;
  }

  .store-name {
    display: block;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .coming-soon-note {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-bottom: 2rem;
  }

  .plan-summary {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 3rem;
    text-align: left;
  }

  .plan {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.5rem;
  }

  .plan.featured {
    border-color: var(--color-accent);
  }

  .plan h3 {
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }

  .plan p {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .requirements {
    padding: 2rem 2rem 4rem;
  }

  .requirements h2 {
    font-size: 1.3rem;
    margin-bottom: 1rem;
    text-align: center;
  }

  .requirements ul {
    max-width: 500px;
    margin: 0 auto;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    padding-left: 1.5rem;
  }

  .requirements li {
    margin-bottom: 0.5rem;
  }

  @media (max-width: 768px) {
    .plan-summary { grid-template-columns: 1fr; }
    .store-buttons { flex-direction: column; align-items: center; }
  }
</style>
