---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Download Seddly — Free Promise Tracker for iOS and Android"
  description="Seddly for iPhone and Android. Turn screenshots into tracked commitments with on-device AI. Free tier available, no account required."
  keywords="download seddly, seddly app, promise tracker download, screenshot tracker iOS, screenshot tracker Android, accountability app download"
>
  <section class="download-hero">
    <div class="download-inner">
      <h1>Download Seddly</h1>
      <!--
        US-184: this page previously advertised iOS only and told Android
        visitors the "Android version [is] coming soon". The Android app has
        been feature-complete since Loop 6 — same OCR, AI extraction, billing,
        sync, notifications, and widget as iOS. The page was understating the
        product and routing Android traffic to a notification signup.

        Neither store listing is live yet, and the iOS button was already a
        placeholder href="#". So both platforms are presented equally and both
        are honestly marked as pre-launch. When a listing goes live, set the
        corresponding URL in STORE_URLS below and the button activates itself.
      -->
      <p class="subtitle">Turn screenshots into accountability. Built for iPhone and Android.</p>

      <div class="store-buttons" id="store-buttons">
        <a href="/support" id="ios-btn" class="store-btn" data-platform="ios" aria-label="Seddly for iPhone — coming to the App Store">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
          <div>
            <span class="store-label">Coming to the</span>
            <span class="store-name">App Store</span>
          </div>
        </a>
        <a href="/support" id="android-btn" class="store-btn" data-platform="android" aria-label="Seddly for Android — coming to Google Play">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true"><path d="M3.61 1.81 13.79 12 3.61 22.19a1.7 1.7 0 0 1-.5-1.2V3.01c0-.47.19-.89.5-1.2zm11.6 11.6 2.58 2.58-10.3 5.88 7.72-8.46zm3.86-3.86 2.42 1.38c.68.39.68 1.35 0 1.74l-2.42 1.38-2.83-2.62 2.83-2.63zM7.49 3.75l10.3 5.88-2.58 2.58-7.72-8.46z"/></svg>
          <div>
            <span class="store-label">Coming to</span>
            <span class="store-name">Google Play</span>
          </div>
        </a>
      </div>

      <p class="prelaunch-note">
        Both apps are built and in final release testing — neither store listing is
        live yet. <a href="/support">Get notified</a> the moment they launch.
      </p>

      <div class="plan-summary">
        <div class="plan">
          <h3>Free</h3>
          <p>5 commitments, on-device processing, basic alerts</p>
        </div>
        <div class="plan featured">
          <h3>Pro — $4.99/mo</h3>
          <p>Unlimited commitments, AI extraction, full notifications, entity profiles</p>
        </div>
        <div class="plan">
          <h3>Pro+ — $9.99/mo</h3>
          <p>Everything in Pro + AI dispute summaries, PDF export, iCloud sync</p>
        </div>
      </div>
    </div>
  </section>

  <section class="requirements">
    <div class="download-inner">
      <h2>Requirements</h2>
      <ul>
        <li>iPhone running iOS 17 or later, or Android 10 or later</li>
        <li>No account required for Free and Pro tiers</li>
        <li>Screenshots album access (photos and personal images are never accessed)</li>
      </ul>
    </div>
  </section>

  <script>
    // US-184: platform detection now emphasises the visitor's own platform on a
    // page that offers both, rather than telling Android visitors the app does
    // not exist yet.
    //
    // To go live, put the real listing URL in the matching entry below. A
    // non-null value flips that button from the pre-launch state to a real
    // store link automatically — no other edit needed.
    (function() {
      const STORE_URLS = {
        ios: null,     // e.g. 'https://apps.apple.com/app/seddly/id0000000000'
        android: null, // e.g. 'https://play.google.com/store/apps/details?id=com.pearsonmedia.seddly'
      };

      const ua = navigator.userAgent || '';
      const platform = /android/i.test(ua)
        ? 'android'
        : /iPad|iPhone|iPod/.test(ua)
          ? 'ios'
          : null;

      for (const btn of document.querySelectorAll('.store-btn')) {
        const key = btn.dataset.platform;
        const url = STORE_URLS[key];

        if (url) {
          btn.href = url;
          const label = btn.querySelector('.store-label');
          if (label) {
            label.textContent = key === 'ios' ? 'Download on the' : 'Get it on';
          }
        } else {
          btn.classList.add('is-prelaunch');
        }

        if (key === platform) {
          btn.classList.add('is-current-platform');
        }
      }
    })();
  </script>
</BaseLayout>

<style>
  .download-hero {
    text-align: center;
    padding: 6rem 2rem 4rem;
  }

  .download-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 2rem;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.75rem;
  }

  .subtitle {
    font-size: 1.2rem;
    color: var(--color-text-muted);
    margin-bottom: 2.5rem;
  }

  .store-buttons {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .store-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: white;
    color: #000;
    padding: 0.75rem 1.75rem;
    border-radius: 12px;
    font-weight: 600;
    transition: transform 0.2s, box-shadow 0.2s;
    text-align: left;
  }

  .store-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(91, 127, 245, 0.2);
    color: #000;
  }

  .store-label {
    display: block;
    font-size: 0.7rem;
    font-weight: 400;
    line-height: 1;
  }

  .store-name {
    display: block;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .prelaunch-note {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-bottom: 2rem;
  }

  /* A button with no live listing yet reads as informational rather than as a
     download call to action. */
  .store-btn.is-prelaunch {
    background: var(--color-surface);
    color: var(--color-text-muted);
    border: 1px dashed var(--color-border);
  }

  .store-btn.is-prelaunch:hover {
    color: var(--color-text-muted);
  }

  /* Emphasise the visitor's own platform without hiding the other. */
  .store-btn.is-current-platform {
    border-color: var(--color-accent);
    border-style: solid;
  }

  .plan-summary {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 3rem;
    text-align: left;
  }

  .plan {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.5rem;
  }

  .plan.featured {
    border-color: var(--color-accent);
  }

  .plan h3 {
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }

  .plan p {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .requirements {
    padding: 2rem 2rem 4rem;
  }

  .requirements h2 {
    font-size: 1.3rem;
    margin-bottom: 1rem;
    text-align: center;
  }

  .requirements ul {
    max-width: 500px;
    margin: 0 auto;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    padding-left: 1.5rem;
  }

  .requirements li {
    margin-bottom: 0.5rem;
  }

  @media (max-width: 768px) {
    .plan-summary { grid-template-columns: 1fr; }
    .store-buttons { flex-direction: column; align-items: center; }
  }
</style>
