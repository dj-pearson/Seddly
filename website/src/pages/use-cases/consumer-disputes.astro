---
import BaseLayout from '../../layouts/BaseLayout.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Seddly for Consumer Disputes — Document Business Promises",
  "description": "Track warranty promises, refund commitments, and service guarantees from businesses with screenshot-based accountability.",
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://seddly.com" },
      { "@type": "ListItem", "position": 2, "name": "Use Cases", "item": "https://seddly.com/use-cases/consumer-disputes" },
      { "@type": "ListItem", "position": 3, "name": "Consumer Disputes" }
    ]
  }
};
---

<BaseLayout
  title="Seddly for Consumer Disputes — Track Warranty, Refund & Service Promises"
  description="A business promised a refund, warranty repair, or service by a deadline? Seddly tracks those commitments from screenshots so you have proof when they don't follow through."
  keywords="consumer dispute tracker, warranty promise tracker, refund tracking app, business accountability app, customer dispute evidence, service guarantee tracker, consumer rights app, complaint documentation app"
  schema={schema}
>
  <section class="page-header">
    <span class="use-case-label">Use Case</span>
    <h1>Document every business promise</h1>
    <p>Track warranties, refund commitments, and service guarantees — so you have proof when businesses don't follow through.</p>
  </section>

  <section class="problem">
    <div class="section-inner">
      <h2>When businesses break promises</h2>
      <div class="problem-grid">
        <div class="problem-card">
          <h3>"Your refund will process in 5-7 days"</h3>
          <p>It's been three weeks. You know they said it in a chat, but the support transcript is gone and you can't prove the original timeline.</p>
        </div>
        <div class="problem-card">
          <h3>"We'll replace it under warranty"</h3>
          <p>Now they're saying the warranty doesn't cover your issue. But you screenshotted the rep who said it would — if only you could find it.</p>
        </div>
        <div class="problem-card">
          <h3>"A technician will be there Tuesday"</h3>
          <p>Tuesday came and went. You rescheduled. They missed again. Without a documented pattern, each miss resets to zero.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="solution">
    <div class="section-inner">
      <h2>How Seddly helps with consumer disputes</h2>
      <div class="steps">
        <div class="step">
          <div class="step-number">1</div>
          <div class="step-content">
            <h3>Screenshot every promise</h3>
            <p>Chat support, email confirmations, DMs — screenshot any commitment a business makes about refunds, repairs, or service dates.</p>
          </div>
        </div>
        <div class="step">
          <div class="step-number">2</div>
          <div class="step-content">
            <h3>Commitments are auto-extracted</h3>
            <p>"Company will process refund of $249 by April 10" becomes a tracked deadline with the business as a named entity.</p>
          </div>
        </div>
        <div class="step">
          <div class="step-number">3</div>
          <div class="step-content">
            <h3>Build a pattern</h3>
            <p>Multiple missed deadlines from the same company build an entity profile. You can see their track record at a glance.</p>
          </div>
        </div>
        <div class="step">
          <div class="step-number">4</div>
          <div class="step-content">
            <h3>Escalate confidently</h3>
            <p>File a chargeback, BBB complaint, or small claims case with a clear timeline of every promise made and broken.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="scenarios">
    <div class="section-inner">
      <h2>What consumers track with Seddly</h2>
      <ul class="scenario-list">
        <li><strong>Refund timelines</strong> — "Your refund will appear in 5-7 business days"</li>
        <li><strong>Warranty coverage</strong> — "This is covered under your 2-year warranty"</li>
        <li><strong>Service appointments</strong> — "A technician will arrive between 9-11am Tuesday"</li>
        <li><strong>Price matches</strong> — "We'll match that price and refund the difference"</li>
        <li><strong>Shipping promises</strong> — "Your replacement ships by end of day"</li>
        <li><strong>Account credits</strong> — "We've applied a $50 credit to your account"</li>
      </ul>
    </div>
  </section>

  <section class="cta-section">
    <div class="section-inner">
      <h2>Never lose proof of a business promise</h2>
      <p>Free to start. No account required. Your screenshots never leave your device.</p>
      <a href="/download" class="cta">Download for iOS</a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    text-align: center;
    padding: 6rem 2rem 3rem;
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .use-case-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    display: block;
    margin-bottom: 0.75rem;
  }

  .page-header h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }

  .page-header p {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    max-width: 600px;
    margin: 0 auto;
  }

  .section-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 4rem 2rem;
  }

  h2 {
    font-size: 1.8rem;
    font-weight: 700;
    text-align: center;
    margin-bottom: 2rem;
    letter-spacing: -0.02em;
  }

  .problem-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .problem-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 2rem;
  }

  .problem-card h3 { margin-bottom: 0.5rem; font-size: 1.1rem; }
  .problem-card p { color: var(--color-text-muted); font-size: 0.9rem; line-height: 1.6; }

  .steps {
    max-width: 650px;
    margin: 0 auto;
  }

  .step {
    display: flex;
    gap: 1.5rem;
    padding: 1.5rem 0;
    border-left: 2px solid var(--color-border);
    margin-left: 17px;
    padding-left: 2rem;
    position: relative;
  }

  .step-number {
    position: absolute;
    left: -18px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--color-accent);
    color: white;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem;
  }

  .step-content h3 { font-size: 1.1rem; margin-bottom: 0.3rem; }
  .step-content p { color: var(--color-text-muted); font-size: 0.9rem; }

  .scenario-list {
    max-width: 600px;
    margin: 0 auto;
    list-style: none;
    padding: 0;
  }

  .scenario-list li {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .scenario-list strong { color: var(--color-text); }

  .cta-section {
    text-align: center;
    padding: 4rem 2rem;
  }

  .cta-section p {
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .cta {
    display: inline-block;
    background: var(--color-accent);
    color: white;
    padding: 0.9rem 2.5rem;
    border-radius: 12px;
    font-weight: 700;
    font-size: 1.05rem;
  }

  .cta:hover { background: var(--color-accent-hover); color: white; }

  @media (max-width: 768px) {
    .problem-grid { grid-template-columns: 1fr; }
  }
</style>
