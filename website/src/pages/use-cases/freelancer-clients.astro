---
import BaseLayout from '../../layouts/BaseLayout.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Seddly for Freelancers — Track Client Payment Promises",
  "description": "Stop chasing invoices. Track client payment commitments, project deadlines, and scope agreements with screenshot-based accountability.",
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://seddly.com" },
      { "@type": "ListItem", "position": 2, "name": "Use Cases", "item": "https://seddly.com/use-cases/freelancer-clients" },
      { "@type": "ListItem", "position": 3, "name": "Freelancer Payments" }
    ]
  }
};
---

<BaseLayout
  title="Seddly for Freelancers — Track Client Payment Promises & Deadlines"
  description="Client said 'Net 30' but it's been 60 days? Seddly tracks payment promises, project deadlines, and scope commitments from screenshots of texts, emails, and DMs."
  keywords="freelance payment tracker, client payment tracking app, invoice promise tracker, freelancer accountability app, late payment tracking, client commitment tracker, scope creep tracker, freelance dispute evidence"
  schema={schema}
>
  <section class="page-header">
    <span class="use-case-label">Use Case</span>
    <h1>Stop chasing client payments</h1>
    <p>Track payment promises, project deadlines, and scope agreements — from the screenshots of conversations you're already saving.</p>
  </section>

  <section class="problem">
    <div class="section-inner">
      <h2>Sound familiar?</h2>
      <div class="problem-grid">
        <div class="problem-card">
          <h3>"We'll pay Net 30"</h3>
          <p>It's now Net 60. You know they said it in an email, but finding the exact screenshot means scrolling through hundreds of photos.</p>
        </div>
        <div class="problem-card">
          <h3>"This is the final round"</h3>
          <p>Three more revision rounds later, you're still working — with no record of the original scope agreement to push back on.</p>
        </div>
        <div class="problem-card">
          <h3>"Check is in the mail"</h3>
          <p>They've said it twice now. Without a timeline of broken promises, each one feels like the first.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="solution">
    <div class="section-inner">
      <h2>How Seddly helps freelancers</h2>
      <div class="steps">
        <div class="step">
          <div class="step-number">1</div>
          <div class="step-content">
            <h3>Screenshot client commitments</h3>
            <p>Payment promises, deadline confirmations, scope agreements — screenshot them from email, Slack, text, or DMs.</p>
          </div>
        </div>
        <div class="step">
          <div class="step-number">2</div>
          <div class="step-content">
            <h3>AI pulls out the details</h3>
            <p>"Client will pay $3,500 by April 15" becomes a tracked commitment. No manual entry needed.</p>
          </div>
        </div>
        <div class="step">
          <div class="step-number">3</div>
          <div class="step-content">
            <h3>Track by client</h3>
            <p>Entity profiles show every commitment from the same client. See their payment history and fulfillment rate at a glance.</p>
          </div>
        </div>
        <div class="step">
          <div class="step-number">4</div>
          <div class="step-content">
            <h3>Escalate with evidence</h3>
            <p>When a client ghosting becomes a dispute, export a professional timeline of every commitment they made and broke.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="scenarios">
    <div class="section-inner">
      <h2>What freelancers track with Seddly</h2>
      <ul class="scenario-list">
        <li><strong>Payment deadlines</strong> — "We'll pay within 30 days of delivery"</li>
        <li><strong>Project milestones</strong> — "Feedback by end of week"</li>
        <li><strong>Scope boundaries</strong> — "Two rounds of revisions included"</li>
        <li><strong>Rate agreements</strong> — "Your rate is $150/hour starting January"</li>
        <li><strong>Contract terms</strong> — "Kill fee is 50% of total project"</li>
        <li><strong>Referral promises</strong> — "I'll send you three more clients this quarter"</li>
      </ul>
    </div>
  </section>

  <section class="cta-section">
    <div class="section-inner">
      <h2>Get paid what you were promised</h2>
      <p>Free to start. No account required. Your screenshots never leave your device.</p>
      <a href="/download" class="cta">Download for iOS</a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    text-align: center;
    padding: 6rem 2rem 3rem;
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .use-case-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    display: block;
    margin-bottom: 0.75rem;
  }

  .page-header h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }

  .page-header p {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    max-width: 600px;
    margin: 0 auto;
  }

  .section-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 4rem 2rem;
  }

  h2 {
    font-size: 1.8rem;
    font-weight: 700;
    text-align: center;
    margin-bottom: 2rem;
    letter-spacing: -0.02em;
  }

  .problem-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .problem-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 2rem;
  }

  .problem-card h3 { margin-bottom: 0.5rem; font-size: 1.1rem; }
  .problem-card p { color: var(--color-text-muted); font-size: 0.9rem; line-height: 1.6; }

  .steps {
    max-width: 650px;
    margin: 0 auto;
  }

  .step {
    display: flex;
    gap: 1.5rem;
    padding: 1.5rem 0;
    border-left: 2px solid var(--color-border);
    margin-left: 17px;
    padding-left: 2rem;
    position: relative;
  }

  .step-number {
    position: absolute;
    left: -18px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--color-accent);
    color: white;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem;
  }

  .step-content h3 { font-size: 1.1rem; margin-bottom: 0.3rem; }
  .step-content p { color: var(--color-text-muted); font-size: 0.9rem; }

  .scenario-list {
    max-width: 600px;
    margin: 0 auto;
    list-style: none;
    padding: 0;
  }

  .scenario-list li {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .scenario-list strong { color: var(--color-text); }

  .cta-section {
    text-align: center;
    padding: 4rem 2rem;
  }

  .cta-section p {
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .cta {
    display: inline-block;
    background: var(--color-accent);
    color: white;
    padding: 0.9rem 2.5rem;
    border-radius: 12px;
    font-weight: 700;
    font-size: 1.05rem;
  }

  .cta:hover { background: var(--color-accent-hover); color: white; }

  @media (max-width: 768px) {
    .problem-grid { grid-template-columns: 1fr; }
  }
</style>
